[Unit]
Description=Quant research agent B (미국 10개 시장 & S&P500 포트폴리오 분석) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/opt/quant/.env
# claude CLI 자체 대기(autoContinueAtUsageLimit)로 사용량 한도 초기화까지 기다릴 수 있으므로
# 타임아웃을 넉넉히(23시간) 잡아 다음날 같은 시각 타이머와 겹치지 않을 정도로만 제한한다.
TimeoutStartSec=82800
ExecStart=/opt/quant/deploy/research_agents/run_research_agent.sh b agent_b_market_portfolio.md

[Install]
WantedBy=multi-user.target
