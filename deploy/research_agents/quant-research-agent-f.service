[Unit]
Description=Quant R&D agent F (비용/세금/리스크 감사관) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/opt/quant/.env
Environment="HOME=/opt/quant"
Environment="CLAUDE_CONFIG_DIR=/opt/quant/.claude"
TimeoutStartSec=82800
ExecStart=/opt/quant/deploy/research_agents/run_research_agent.sh f agent_f_cost_tax_auditor.md

[Install]
WantedBy=multi-user.target
