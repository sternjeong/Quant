[Unit]
Description=Quant R&D agent E (실행 준비가 — 이번 달 실제 매매안 작성) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/opt/quant/.env
Environment="HOME=/opt/quant"
Environment="CLAUDE_CONFIG_DIR=/opt/quant/.claude"
TimeoutStartSec=82800
ExecStart=/opt/quant/deploy/research_agents/run_research_agent.sh e agent_e_execution_readiness.md

[Install]
WantedBy=multi-user.target
