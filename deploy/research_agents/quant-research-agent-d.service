[Unit]
Description=Quant R&D agent D (전략 구성가 — swing 매매 후보 전략 종합) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/opt/quant/.env
Environment="HOME=/opt/quant"
Environment="CLAUDE_CONFIG_DIR=/opt/quant/.claude"
TimeoutStartSec=82800
ExecStart=/opt/quant/deploy/research_agents/run_research_agent.sh d agent_d_strategy_constructor.md

[Install]
WantedBy=multi-user.target
