[Unit]
Description=Quant research agent C (개별주 & 텐베거 발굴 방법) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/opt/quant/.env
TimeoutStartSec=82800
ExecStart=/opt/quant/deploy/research_agents/run_research_agent.sh c agent_c_tenbagger.md

[Install]
WantedBy=multi-user.target
