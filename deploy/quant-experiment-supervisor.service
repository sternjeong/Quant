[Unit]
Description=Quant two-week experiment supervisor and daily Telegram HTML reporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant
WorkingDirectory=/opt/quant
Environment="HOME=/opt/quant"
Environment="CLAUDE_CONFIG_DIR=/opt/quant/.claude"
Environment="TELEGRAM_EXPERIMENT_ENV_FILE=/opt/quant/.codex-telegram-runtime/telegram.env"
Environment="EXPERIMENT_AGENT_INTERVAL_SECONDS=14400"
Environment="EXPERIMENT_AGENT_TIMEOUT_SECONDS=10800"
Environment="EXPERIMENT_REPORT_INTERVAL_SECONDS=86400"
ExecStart=/usr/bin/python3 /opt/quant/deploy/experiment_supervisor.py --root /opt/quant
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
