#!/usr/bin/env python3
"""quant-proc-signal — 관제 허브(quant)가 과부하 때 ubuntu·quant 계정 프로세스를 일시정지/재개/종료하는 root 도우미.

설치: sudo bash /opt/quant/deploy/proc_control/setup.sh  (/usr/local/sbin 에 복사 + sudoers 한 줄: quant 만, 이 파일만)
사용: sudo -n /usr/local/sbin/quant-proc-signal <STOP|CONT|TERM|KILL> <pid> [pid ...]
      sudo -n /usr/local/sbin/quant-proc-signal INFO <pid> [pid ...]   (읽기 전용: 작업 폴더를 "<pid> cwd <경로>" 로 출력)
안전장치: 대상은 ubuntu·quant 계정 프로세스뿐(root·시스템 계정 거부), 보호 목록(허브·nginx·sshd·systemd·tmux 서버·셸 등)은 거부.
결과는 pid 마다 한 줄(ok/거부 사유)로 출력하고, 하나라도 거부·실패하면 종료 코드 2.
"""
import os
import pwd
import signal
import sys

ALLOWED_USERS = ("ubuntu", "quant")
SIGNALS = {"STOP": signal.SIGSTOP, "CONT": signal.SIGCONT, "TERM": signal.SIGTERM, "KILL": signal.SIGKILL}
PROTECTED_COMM = {"systemd", "sshd", "nginx", "sudo", "tmux: server", "bash", "sh", "login", "agetty", "dbus-daemon"}
PROTECTED_CMD = ("hub.server", "quant-proc-signal", "unattended-upgrade")


def check(pid: int) -> str:
    try:
        st = os.stat(f"/proc/{pid}")
        with open(f"/proc/{pid}/comm") as f:
            comm = f.read().strip()
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return "없는 프로세스"
    try:
        user = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        return "알 수 없는 계정"
    if user not in ALLOWED_USERS:
        return f"{user} 계정 프로세스는 건드릴 수 없음"
    if not cmd.strip():
        return "커널 스레드"
    if pid <= 1 or comm in PROTECTED_COMM or any(p in cmd for p in PROTECTED_CMD):
        return f"보호 프로세스({comm})"
    return ""


def info(pid: int) -> str:
    """읽기 전용 — 보호 프로세스도 폴더는 보여 준다(계정 제한만 적용)."""
    try:
        user = pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid).pw_name
        if user not in ALLOWED_USERS:
            return f"{pid} 거부: {user} 계정"
        return f"{pid} cwd {os.readlink(f'/proc/{pid}/cwd')}"
    except (OSError, KeyError):
        return f"{pid} 거부: 없는 프로세스"


def main() -> int:
    if len(sys.argv) >= 3 and sys.argv[1] == "INFO":
        for arg in sys.argv[2:50]:
            print(info(int(arg)) if arg.isdigit() else f"{arg} 거부: pid 형식 아님")
        return 0
    if len(sys.argv) < 3 or sys.argv[1] not in SIGNALS:
        print("usage: quant-proc-signal <STOP|CONT|TERM|KILL|INFO> <pid>...", file=sys.stderr)
        return 64
    sig, bad = SIGNALS[sys.argv[1]], 0
    for arg in sys.argv[2:50]:
        if not arg.isdigit():
            print(f"{arg} 거부: pid 형식 아님")
            bad += 1
            continue
        pid = int(arg)
        why = check(pid)
        if why:
            print(f"{pid} 거부: {why}")
            bad += 1
            continue
        try:
            os.kill(pid, sig)
            print(f"{pid} ok")
        except OSError as exc:
            print(f"{pid} 실패: {exc.strerror}")
            bad += 1
    return 2 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
