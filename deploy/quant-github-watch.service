[Unit]
Description=Quant GitHub 감시 (Actions 워크플로가 새로 실패하면 텔레그램) — 1회 실행용
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quant
WorkingDirectory=/opt/quant
# /var/lib/quant-github-watch 를 quant 소유로 자동 생성·유지한다(재부팅 후에도 남는다).
StateDirectory=quant-github-watch
ExecStart=/usr/bin/python3 /opt/quant/deploy/github_watch.py
