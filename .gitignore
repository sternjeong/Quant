# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- 환경변수 ---
.env

# --- DB / 캐시 데이터 (로컬 산출물, 커밋하지 않음) ---
data/*.db
data/*.db-journal
data/cache/*
!data/cache/.gitkeep
!data/.gitkeep
# core.process_registry의 잡 on/off 상태 — 배포 환경마다 다른 실시간 사용자 설정이라 DB/캐시와
# 같은 이유로 커밋하지 않는다 (텔레그램 /processes 로 사용자가 직접 바꿈).
data/process_toggles.json
# 에이전트 역할별 모델 선택(허브 /research·텔레그램 /models)과 에이전트 사용 기록 — VM 실시간 상태, 커밋하지 않음(백업은 함).
data/agent_models.json
data/agent_usage.jsonl
# 거시지표(FRED) 캐시는 예외적으로 커밋한다 - 야간 GitHub Actions가 갱신해두면
# Streamlit Cloud 배포본이 매 방문마다 FRED API를 안 때리고 이 캐시를 바로 읽을 수 있다.
# 개별 종목 가격 parquet 캐시(1000개+, 수십MB)는 계속 불어나므로 커밋 대상에서 제외.
!data/cache/fred_*.csv

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / 에디터 ---
.DS_Store
.idea/
.vscode/

# --- 테스트 ---
.pytest_cache/
.coverage

# --- 임시 분석/튜닝 스크립트 산출물 (재현 가능, 커밋하지 않음) ---
.tuning_runs/

# Telegram Codex private runtime
.codex-telegram-runtime/
.codex-telegram-state/
.news-digest/
deploy/codex_telegram/config.json

# 텔레그램 /note 로 저장한 개인 메모·첨부 (deploy/codex_telegram/runner.py).
# 이 저장소는 공개라 여기엔 절대 올리지 않는다 — 대신 야간 백업이 **비공개** 저장소로 가져간다
# (deploy/backup_vm.py의 ALLOWED_PREFIXES에 notes/ 가 들어 있음, docs/TELEGRAM_REPO_BRIDGE_SPEC.md 3-1).
notes/
